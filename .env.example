# Docs Vault Kit configuration (SPEC §13). `scripts/setup` writes .env from this file; rerun
# `scripts/setup --reconfigure` after changing INGRESS. Keep .env private (it holds secrets).

# Core
VAULT_PATH=/srv/vault
DATA_PATH=/srv/vault-data
VAULT_NAME=Docs
PUID=1000
PGID=1000
BIND_ADDR=127.0.0.1
IGNIS_PORT=8081
MCP_PORT=8082
# Upgrade these two together (docs/UPGRADING.md): the digest pins exactly this Obsidian version.
IGNIS_IMAGE=nobbe/ignis@sha256:2049be7dfbbee5ee9fa5c0ae56efd8555ec57f2ac3275448b1c4318b8af49bb5
OBSIDIAN_VERSION=1.14.4
HISTORY_RETENTION_DAYS=90
HISTORY_MIN_VERSIONS=10

# Ingress: cloudflare | caddy | local | none
INGRESS=local
DOMAIN=example.com
IGNIS_HOST=docs.example.com
MCP_HOST=docs-mcp.example.com
CF_TUNNEL_TOKEN=
OAUTH_PROVIDER=google                 # caddy profile (oauth2-proxy)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_COOKIE_SECRET=                  # caddy profile; setup generates it
OAUTH_ALLOWED_EMAIL_DOMAINS=example.com
ACME_EMAIL=

# vault-mcp OAuth (for Claude.ai / ChatGPT connectors). Setup sets the issuer to https://MCP_HOST.
MCP_OAUTH_ENABLED=true
MCP_OAUTH_ISSUER=
OAUTH_UPSTREAM_PROVIDER=none          # google | microsoft | github | oidc | none (admin approval codes)
OAUTH_UPSTREAM_CLIENT_ID=
OAUTH_UPSTREAM_CLIENT_SECRET=
OAUTH_UPSTREAM_ALLOWED_EMAIL_DOMAINS=example.com
OAUTH_UPSTREAM_ISSUER=                # provider=oidc: the provider's https issuer URL
OAUTH_UPSTREAM_TENANT=                # provider=microsoft: your tenant id or domain

# Git backup (optional; turns on the git-sync service)
GIT_REMOTE=
SYNC_INTERVAL=120
GIT_LFS=false
GIT_BRANCH=main
GIT_ADOPT_REMOTE=false                # true: rebase the vault onto a remote that already has history

# Server-side agent (optional; turns on agent-runner)
ANTHROPIC_API_KEY=                    # pay-per-use API key, or instead:
CLAUDE_CODE_OAUTH_TOKEN=              # a Claude subscription token from `claude setup-token`
AGENT_MODEL=
AGENT_MONTHLY_BUDGET=
INGEST_CRON='0 * * * *'
LINT_CRON='0 2 * * *'
INGEST_MAX_SOURCES=10                 # sources per ingest run
AGENT_MAX_TURNS=200
AGENT_COMMAND=
AGENT_RUNNER_TOKEN=                   # setup creates it when agent-runner is on

# Alerts (Slack, Discord, or any URL that accepts JSON)
ALERT_WEBHOOK=
MONITOR_INTERVAL_S=60

# Tuning (rarely changed)
HISTORY_ACK_TIMEOUT=5
IGNIS_PLUGINS_FILE=./ignis/ignis-plugins.yaml
IGNIS_SERVER_PLUGINS=                 # Ignis server plugins allowed on (e.g. headless-sync); empty: reset at start, alert if enabled

# Written by scripts/setup from INGRESS, GIT_REMOTE and ANTHROPIC_API_KEY/AGENT_COMMAND (plan D5)
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=
