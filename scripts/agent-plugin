#!/usr/bin/env bash
# Build the docs-vault agent plugin for this deployment (SPEC §10.1).
#
#   scripts/agent-plugin [--url https://docs-mcp.example.com/mcp] [--out DIR] [--name NAME]
#
# Writes a plugin marketplace that Claude Code, Codex and omp can install from. The vault's MCP
# address is written into the plugin, so team members only install it and sign in (OAuth).
# Defaults: --url https://$MCP_HOST/mcp from .env, --out ./agent-plugin-dist, --name docs-vault.
# Publish DIR as a git repository your team can read (see docs/CONNECT-AGENTS.md).
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

die() { echo "agent-plugin: $*" >&2; exit 1; }

url="" out="agent-plugin-dist" name="docs-vault"
while [ $# -gt 0 ]; do
  case "$1" in
    --url) [ $# -ge 2 ] || die "--url needs a value"; url="$2"; shift 2 ;;
    --out) [ $# -ge 2 ] || die "--out needs a value"; out="$2"; shift 2 ;;
    --name) [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

if [ -z "$url" ]; then
  [ -f .env ] || die "no .env; pass --url"
  host="$(sed -n 's/^MCP_HOST=\([^[:space:]#]*\).*/\1/p' .env | tail -n 1)"
  [ -n "$host" ] || die "MCP_HOST is not set in .env; pass --url"
  url="https://$host/mcp"
fi

# The address is written into JSON unescaped, so accept only plain URLs: https anywhere, http
# only on loopback (INGRESS=local over an SSH tunnel).
https_re='^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$'
loopback_re='^http://(127\.0\.0\.1|localhost)(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$'
[[ "$url" =~ $https_re || "$url" =~ $loopback_re ]] \
  || die "--url must be https://host[:port]/path (or http on 127.0.0.1/localhost): $url"
[[ "$name" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || die "--name must be kebab-case: $name"

[ ! -e "$out" ] || [ -z "$(ls -A "$out")" ] || [ -f "$out/.claude-plugin/marketplace.json" ] \
  || die "$out exists and is not an agent-plugin output; choose another --out"

plugin="$out/$name"
rm -rf "$plugin" "$out/.claude-plugin" "$out/.agents"
mkdir -p "$plugin/.claude-plugin" "$out/.claude-plugin" "$out/.agents/plugins"
cp -R vault-template/skills "$plugin/skills"
cp -R agent-plugin/commands "$plugin/commands"

description="Connects your agent to the team docs vault at $url (browser sign-in) and adds the docs-ingest, docs-query and docs-lint skills."

# Portable Agent Plugins package (Codex, omp). No `extensions` block on the server: omp rejects
# unknown fields there, and Codex finds the OAuth endpoints through the server's metadata.
cat > "$plugin/plugin.json" <<EOF
{
  "\$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "$name",
  "version": "0.1.0",
  "description": "$description",
  "license": "MIT"
}
EOF
cat > "$plugin/mcp.json" <<EOF
{
  "\$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "vault": {
      "type": "streamable-http",
      "url": "$url"
    }
  }
}
EOF

# Claude Code manifest and server.
cat > "$plugin/.claude-plugin/plugin.json" <<EOF
{
  "name": "$name",
  "displayName": "Docs Vault",
  "version": "0.1.0",
  "description": "$description",
  "author": { "name": "Docs Vault Kit" },
  "license": "MIT"
}
EOF
cat > "$plugin/.mcp.json" <<EOF
{
  "mcpServers": {
    "vault": { "type": "http", "url": "$url" }
  }
}
EOF

# Marketplace catalogs: Claude Code and omp read .claude-plugin/, Codex reads .agents/plugins/.
cat > "$out/.claude-plugin/marketplace.json" <<EOF
{
  "name": "$name",
  "owner": { "name": "Docs Vault Kit" },
  "metadata": { "description": "The team docs vault plugin for this deployment." },
  "plugins": [
    { "name": "$name", "source": "./$name", "description": "$description" }
  ]
}
EOF
cat > "$out/.agents/plugins/marketplace.json" <<EOF
{
  "name": "$name",
  "plugins": [
    {
      "name": "$name",
      "source": { "source": "local", "path": "./$name" },
      "policy": { "installation": "AVAILABLE", "authentication": "ON_INSTALL" },
      "category": "Productivity"
    }
  ]
}
EOF

echo "wrote $out (plugin $name@$name, MCP address $url)"
echo "next: publish $out as a git repository your team can read; install steps are in docs/CONNECT-AGENTS.md"
