{
  "description": "Docs vault session capture: context block at session start and after compaction or clear; a capture reminder every 10th prompt. Allowlisted repos only; no credentials.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt-nudge.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
